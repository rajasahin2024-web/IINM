# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://lmsdbdev:7xMZHtjArXEp5Ztk@100.127.39.1:5432/lmsdbdev

# Secret for device admin panel
DEVICE_ADMIN_SECRET=change-this-to-a-long-random-string

# Secret for student session token signing (HMAC)
STUDENT_AUTH_SECRET=change-this-to-another-long-random-string

# Google Maps API key (optional)
GOOGLE_MAPS_API_KEY=

# Set to true only in local development
ENABLE_DOCS=false

# Public frontend URL used in outbound emails (password reset links)
FRONTEND_URL=https://iinmedu.com

# ── Webinar funnel (₹499 ticket → eWebinar auto-registration) ──
# Ticket price in INR (board-approved ₹499). Razorpay keys live in Admin → Settings → Payment.
WEBINAR_TICKET_PRICE_INR=499
WEBINAR_TITLE=
# eWebinar REST API v2 — Team settings → Integrations → API access (needs `Registrants` permission)
EWEBINAR_API_KEY=
EWEBINAR_WEBINAR_ID=
EWEBINAR_API_BASE=https://api.ewebinar.com/v2
# Optional: fixed ISO-8601 session time; leave empty for JIT/next-session registration
EWEBINAR_SESSION_TIME=
# Optional generic endpoint (e.g. Zapier catch hook) — used INSTEAD of the REST API when set
EWEBINAR_REGISTRATION_URL=
# Shared secret for the inbound eWebinar registrant webhook (pass as ?token=… on the hook URL)
EWEBINAR_HOOK_TOKEN=
# Razorpay dashboard → Webhooks secret (payment.captured backup for /verify)
RAZORPAY_WEBHOOK_SECRET=
# Bearer token guarding the caller sheet + ops endpoints (telecall team)
CALLER_SHEET_TOKEN=
